---
import type { Locale } from '../i18n/page-map';

interface Props {
  lang?: Locale;
}

const { lang = 'ca' } = Astro.props;

const wikilocEmbedSrc =
  'https://ca.wikiloc.com/wikiloc/embedv2.do?id=276745362&elevation=on&images=on&maptype=H';
const wikilocLink = 'https://ca.wikiloc.com/rutes-correr/mitja-marato-delta-de-lebre-2-276745362';

const content = {
  ca: {
    heading: 'El recorregut',
    lead: "21,097 km travessant alguns dels paisatges més emblemàtics del Delta de l'Ebre: arrossars i miradors naturals. Un recorregut circular amb sortida i arribada al mateix punt.",
    facts: [
      { value: '21,097 km', label: 'Distància' },
      { value: 'Mixt', label: 'Paviment' },
      { value: 'Poble Nou del Delta', label: 'Sortida i arribada' },
    ],
    highlights: [
      { label: 'Sortida', km: 0 },
      { label: 'Observatori de la Tancada', km: 4.7 },
      { label: 'Mirador de la Tancada', km: 6.8 },
      { label: 'Platja dels Eucaliptus', km: 9.5 },
      { label: 'Mirador de la Tancada', km: 13.7 },
      { label: "Mirador de l'Embut", km: 18.1 },
      { label: 'Mirador del Través', km: 20.1 },
      { label: 'Arribada', km: 21.097 },
    ],
    mapTitle: "Mapa del recorregut - Mitja Delta de l'Ebre (Wikiloc)",
    mapCredit: 'Mapa del recorregut via',
  },
  es: {
    heading: 'El recorrido',
    lead: 'Recorrido circular de 21,097 km que atraviesa algunos de los paisajes más emblemáticos del Delta del Ebre: arrozales y miradores naturales, con salida y llegada en el mismo punto.',
    facts: [
      { value: '21,097 km', label: 'Distancia' },
      { value: 'Mixto', label: 'Pavimento' },
      { value: 'Poble Nou del Delta', label: 'Salida y llegada' },
    ],
    highlights: [
      { label: 'Salida', km: 0 },
      { label: 'Observatorio de la Tancada', km: 4.7 },
      { label: 'Mirador de la Tancada', km: 6.8 },
      { label: 'Playa de los Eucaliptus', km: 9.5 },
      { label: 'Mirador de la Tancada', km: 13.7 },
      { label: 'Mirador del Embut', km: 18.1 },
      { label: 'Mirador del Través', km: 20.1 },
      { label: 'Llegada', km: 21.097 },
    ],
    mapTitle: "Mapa del recorrido - Mitja Delta de l'Ebre (Wikiloc)",
    mapCredit: 'Mapa del recorrido vía',
  },
};

const t = content[lang];
---

<section class="route" id="recorregut">
  <div class="route-inner">
    <div class="route-layout">
      <div class="route-content">
        <h2>{t.heading}</h2>
        <p class="route-lead">{t.lead}</p>

        <div class="route-facts">
          {
            t.facts.map((fact) => (
              <div class="route-fact">
                <span class="route-fact-value">{fact.value}</span>
                <span class="route-fact-label">{fact.label}</span>
              </div>
            ))
          }
        </div>

        <ul class="route-highlights-list">
          {
            t.highlights.map((point) => (
              <li>
                <span class="route-highlights-km">{point.km} km</span>
                <span class="route-highlights-label">{point.label}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="route-map-wrapper">
        <div class="route-map">
          <iframe
            title={t.mapTitle}
            src={wikilocEmbedSrc}
            scrolling="no"
            loading="lazy"
          ></iframe>
        </div>
        <p class="route-map-credit">
          {t.mapCredit} <a href={wikilocLink} target="_blank" rel="noopener noreferrer">Wikiloc</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .route {
    background-color: var(--color-gray-light);
    padding: 3rem 1.5rem;
  }

  .route-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .route-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .route h2 {
    color: var(--color-navy);
    font-size: 2rem;
    margin: 0 0 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 4px solid var(--color-olive);
    display: inline-block;
  }

  .route-lead {
    color: var(--color-navy);
    line-height: 1.6;
    margin: 1rem 0 2rem;
  }

  .route-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .route-fact {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-right: 2rem;
    border-right: 1px solid var(--color-gray-mid);
  }

  .route-fact:last-child {
    border-right: none;
  }

  .route-fact-value {
    color: var(--color-navy);
    font-size: 1.4rem;
    font-weight: 700;
  }

  .route-fact-label {
    color: var(--color-gray-mid);
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.03em;
  }

  .route-map-wrapper {
    background-color: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    padding: 1rem;
  }

  .route-map {
    border-radius: 8px;
    overflow: hidden;
  }

  .route-map iframe {
    width: 100%;
    height: 560px;
    border: 0;
    display: block;
  }

  .route-map-credit {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--color-gray-mid);
  }

  .route-map-credit a {
    color: var(--color-olive);
  }

  .route-highlights-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 1.5rem;
  }

  .route-highlights-list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-left: 0.75rem;
    border-left: 3px solid var(--color-olive);
  }

  .route-highlights-km {
    color: var(--color-navy);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .route-highlights-label {
    color: var(--color-gray-mid);
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .route-layout {
      grid-template-columns: 1fr;
    }

    .route-map iframe {
      height: 420px;
    }
  }

  @media (max-width: 480px) {
    .route-highlights-list {
      grid-template-columns: 1fr;
    }
  }
</style>
