---
import { Image } from 'astro:assets';
import p1 from '../assets/images/delta/_DSC5445.jpg';
import p2 from '../assets/images/delta/_DSC5446.jpg';
import p3 from '../assets/images/delta/_DSC5466.jpg';
import p4 from '../assets/images/delta/delta1.png';
import p5 from '../assets/images/delta/_DSC5536.jpg';
import p6 from '../assets/images/delta/delta2.jpg';

const photos = [{ src: p1 }, { src: p2 }, { src: p3 }, { src: p4 }, { src: p5 }, { src: p6 }];
---

<section class="gallery">
  <div class="gallery-strip">
    {
      photos.map((photo, i) => (
        <a href={`#delta-foto-${i}`} class="gallery-thumb">
          <Image
            src={photo.src}
            alt={`Foto ${i + 1} del Delta de l'Ebre`}
            width={500}
            class="gallery-thumb-img"
            style={`object-position: ${photo.focus ?? 'center'};`}
          />
        </a>
      ))
    }
  </div>

  {
    photos.map((photo, i) => (
      <div class="lightbox" id={`delta-foto-${i}`}>
        <a href="#" class="lightbox-backdrop" aria-label="Tanca la imatge" />
        <div class="lightbox-inner">
          <Image src={photo.src} alt={`Foto ${i + 1} del Delta de l'Ebre`} width={1400} class="lightbox-img" />
          <a href="#" class="lightbox-close" aria-label="Tanca">
            &times;
          </a>
        </div>
      </div>
    ))
  }
</section>

<style>
  .gallery {
    background-color: #fff;
    padding: 0;
  }

  .gallery-strip {
    display: flex;
    width: 100%;
    height: 180px;
    gap: 0;
  }

  .gallery-thumb {
    flex: 1;
    display: block;
    height: 100%;
    overflow: hidden;
  }

  .gallery-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .gallery-thumb:hover .gallery-thumb-img {
    transform: scale(1.06);
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    align-items: center;
    justify-content: center;
  }

  .lightbox:target {
    display: flex;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(3, 36, 68, 0.92);
  }

  .lightbox-inner {
    position: relative;
    z-index: 1;
    max-width: 92vw;
    max-height: 88vh;
  }

  .lightbox-img {
    display: block;
    max-width: 92vw;
    max-height: 88vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
  }

  .lightbox-close {
    position: absolute;
    top: -2.5rem;
    right: 0;
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .gallery-strip {
      height: 125px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      cursor: grab;
    }

    .gallery-strip::-webkit-scrollbar {
      display: none;
    }

    .gallery-strip.dragging {
      cursor: grabbing;
      scroll-snap-type: none;
      user-select: none;
    }

    .gallery-thumb {
      flex: 0 0 42%;
      scroll-snap-align: start;
    }
  }
</style>

<script>
  document.querySelectorAll('.gallery-strip').forEach((strip) => {
    let isDown = false;
    let moved = false;
    let startX = 0;
    let startScroll = 0;

    strip.addEventListener('mousedown', (e) => {
      isDown = true;
      moved = false;
      startX = e.pageX;
      startScroll = strip.scrollLeft;
      strip.classList.add('dragging');
    });

    const stopDrag = () => {
      isDown = false;
      strip.classList.remove('dragging');
    };

    strip.addEventListener('mouseleave', stopDrag);
    strip.addEventListener('mouseup', stopDrag);

    strip.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      const delta = e.pageX - startX;
      if (Math.abs(delta) > 5) moved = true;
      e.preventDefault();
      strip.scrollLeft = startScroll - delta;
    });

    strip.addEventListener(
      'click',
      (e) => {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
        }
      },
      true
    );
  });
</script>
