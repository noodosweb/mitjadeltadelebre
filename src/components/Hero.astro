---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/portada.jpg';
import logo from '../assets/images/logo_blanc.png';
import type { Locale } from '../i18n/page-map';

interface Props {
  lang?: Locale;
}

const { lang = 'ca' } = Astro.props;

const content = {
  ca: {
    alt: "Mitja Marató Delta de l'Ebre",
    title: "Mitja Marató Delta de l'Ebre - Grup Oliva Motor",
    info: "Obertura d'inscripcions: 8/08/2026",
    cta: 'Inscripcions',
  },
  es: {
    alt: 'Media Maratón Delta del Ebre',
    title: 'Media Maratón Delta del Ebre - Grup Oliva Motor',
    info: 'Apertura de inscripciones: 8/08/2026',
    cta: 'Inscripciones',
  },
};

const t = content[lang];
---

<section class="hero">
  <Image src={heroImage} alt={t.alt} class="hero-bg" loading="eager" fetchpriority="high" />
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <Image src={logo} alt={t.alt} class="hero-logo" loading="eager" />
    <p class="hero-date">18.04.2027</p>
    <h1 class="hero-title">{t.title}</h1>
    <p class="hero-info">{t.info}</p>
    <a class="hero-cta" href="https://www.rockthesport.com/es/evento/mitja-delta-del-ebre" target="_blank" rel="noopener noreferrer">{t.cta}</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 640px;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.75) 100%);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    color: #fff;
    padding: 3rem 1.5rem 4.5rem;
    max-width: 720px;
    text-align: center;
  }

  .hero-logo {
    width: 380px;
    height: auto;
    margin: 0 auto 1.5rem;
  }

  .hero-date {
    font-size: 3.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    letter-spacing: 0.05em;
  }

  .hero-title {
    font-size: 1.4rem;
    margin: 0 0 0.5rem;
  }

  .hero-info {
    margin: 0 0 1.5rem;
    opacity: 0.9;
  }

  .hero-cta {
    display: inline-block;
    background: #fff;
    color: var(--color-navy);
    font-weight: 700;
    padding: 0.9rem 2rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .hero-cta:hover {
    background-color: var(--color-delta-green);
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
  }

  @media (max-width: 720px) {
    .hero {
      min-height: 520px;
    }

    .hero-content {
      padding: 2.5rem 1.25rem 3.5rem;
    }

    .hero-logo {
      width: 260px;
    }

    .hero-date {
      font-size: 2.5rem;
    }

    .hero-title {
      font-size: 1.15rem;
    }
  }

  @media (max-width: 480px) {
    .hero {
      min-height: 460px;
    }

    .hero-logo {
      width: 200px;
      margin-bottom: 1rem;
    }

    .hero-date {
      font-size: 2rem;
    }

    .hero-title {
      font-size: 1rem;
    }

    .hero-info {
      font-size: 0.9rem;
    }

    .hero-cta {
      padding: 0.8rem 1.6rem;
      font-size: 0.95rem;
    }
  }
</style>
