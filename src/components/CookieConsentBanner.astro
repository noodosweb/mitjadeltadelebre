---
import { pageMap, type Locale } from '../i18n/page-map';

interface Props {
	lang?: Locale;
}

const { lang = 'ca' } = Astro.props;

const content = {
	ca: {
		ariaLabel: 'Gestionar consentiment',
		textBefore: "Utilitzem cookies pròpies per al funcionament del lloc web i, si ho consentiu, per mesurar-ne l'ús (Google Analytics). Més informació a la",
		textLink: 'política de cookies',
		categories: {
			functional: { name: 'Funcional', alwaysOn: 'Sempre activa', desc: 'Necessària pel funcionament bàsic del lloc web. No es pot desactivar.' },
			preferences: { name: 'Preferències', desc: "Recorda opcions no essencials triades per l'usuari." },
			statistics: { name: 'Estadístiques', desc: "Ens permet mesurar l'ús anònim del lloc web (Google Analytics)." },
			marketing: {
				name: 'Màrqueting',
				desc: "Actualment no fem servir cap cookie de màrqueting. Categoria preparada per si en el futur s'hi afegeix publicitat o remarketing.",
			},
		},
		reject: 'Rebutjar-ho tot',
		save: 'Desar preferències',
		accept: 'Acceptar-ho tot',
	},
	es: {
		ariaLabel: 'Gestionar consentimiento',
		textBefore: 'Utilizamos cookies propias para el funcionamiento del sitio web y, si lo consientes, para medir su uso (Google Analytics). Más información en la',
		textLink: 'política de cookies',
		categories: {
			functional: { name: 'Funcional', alwaysOn: 'Siempre activa', desc: 'Necesaria para el funcionamiento básico del sitio web. No se puede desactivar.' },
			preferences: { name: 'Preferencias', desc: 'Recuerda opciones no esenciales elegidas por el usuario.' },
			statistics: { name: 'Estadísticas', desc: 'Nos permite medir el uso anónimo del sitio web (Google Analytics).' },
			marketing: {
				name: 'Marketing',
				desc: 'Actualmente no utilizamos ninguna cookie de marketing. Categoría preparada por si en el futuro se añade publicidad o remarketing.',
			},
		},
		reject: 'Rechazar todo',
		save: 'Guardar preferencias',
		accept: 'Aceptar todo',
	},
};

const t = content[lang];
const cookiePolicyHref = pageMap.cookies[lang];
---

<div
	id="cookie-banner"
	class="cookie-banner"
	role="dialog"
	aria-modal="true"
	aria-label={t.ariaLabel}
	hidden
	style="--cookie-font: var(--font-sans, system-ui, sans-serif); --cookie-surface: var(--color-navy-dark, #1a1a1a); --cookie-text: #fff; --cookie-accent: var(--color-accent-gold, #e8b84b); --cookie-accent-text: var(--color-navy-dark, #1a1a1a); --cookie-radius: 0.5rem; position: fixed; bottom: 0; left: 0; right: 0; z-index: 9999; padding: 1rem; max-height: 100vh; overflow-y: auto; font-family: var(--cookie-font);"
>
	<div class="cookie-banner__inner">
		<p class="cookie-banner__text">
			{t.textBefore}{' '}
			<a href={cookiePolicyHref}>{t.textLink}</a>.
		</p>

		<div class="cookie-banner__categories">
			<div class="cookie-category">
				<div class="cookie-category__header">
					<span>{t.categories.functional.name}</span>
					<span class="cookie-category__always-on">{t.categories.functional.alwaysOn}</span>
				</div>
				<p class="cookie-category__desc">{t.categories.functional.desc}</p>
			</div>

			<div class="cookie-category">
				<label class="cookie-category__header">
					<span>{t.categories.preferences.name}</span>
					<input type="checkbox" id="cookie-cat-preferences" />
				</label>
				<p class="cookie-category__desc">{t.categories.preferences.desc}</p>
			</div>

			<div class="cookie-category">
				<label class="cookie-category__header">
					<span>{t.categories.statistics.name}</span>
					<input type="checkbox" id="cookie-cat-statistics" />
				</label>
				<p class="cookie-category__desc">{t.categories.statistics.desc}</p>
			</div>

			<div class="cookie-category">
				<label class="cookie-category__header">
					<span>{t.categories.marketing.name}</span>
					<input type="checkbox" id="cookie-cat-marketing" />
				</label>
				<p class="cookie-category__desc">
					{t.categories.marketing.desc}
				</p>
			</div>
		</div>

		<div class="cookie-banner__actions">
			<button type="button" id="cookie-reject" class="cookie-btn cookie-btn--secondary">{t.reject}</button>
			<button type="button" id="cookie-save" class="cookie-btn cookie-btn--secondary">{t.save}</button>
			<button type="button" id="cookie-accept" class="cookie-btn cookie-btn--primary">{t.accept}</button>
		</div>
	</div>
</div>

<script>
	import { trackPageView } from "../lib/analytics";
	import {
		applyConsent,
		getStoredConsent,
		saveConsent,
		OPEN_EVENT,
		type ConsentCategories,
	} from "../lib/consent";

	const banner = document.getElementById("cookie-banner") as HTMLElement;
	const preferencesInput = document.getElementById("cookie-cat-preferences") as HTMLInputElement;
	const statisticsInput = document.getElementById("cookie-cat-statistics") as HTMLInputElement;
	const marketingInput = document.getElementById("cookie-cat-marketing") as HTMLInputElement;

	const ALL_ON: ConsentCategories = { preferences: true, statistics: true, marketing: true };
	const ALL_OFF: ConsentCategories = { preferences: false, statistics: false, marketing: false };

	function syncInputs(categories: ConsentCategories) {
		preferencesInput.checked = categories.preferences;
		statisticsInput.checked = categories.statistics;
		marketingInput.checked = categories.marketing;
	}

	function readInputs(): ConsentCategories {
		return {
			preferences: preferencesInput.checked,
			statistics: statisticsInput.checked,
			marketing: marketingInput.checked,
		};
	}

	function decide(chosen: ConsentCategories) {
		const previous = getStoredConsent();
		saveConsent(chosen);
		applyConsent(chosen);
		// gtag('config', ...) del <head> ja va disparar sota consentiment 'denied' per defecte;
		// aquest page_view manual recupera el hit perdut d'aquesta càrrega si s'acaba de concedir.
		if (chosen.statistics && !previous?.statistics) {
			trackPageView(window.location.pathname);
		}
		banner.setAttribute("hidden", "");
	}

	const stored = getStoredConsent();
	if (!stored) {
		syncInputs(ALL_OFF);
		banner.removeAttribute("hidden");
	} else {
		syncInputs(stored);
	}

	document.getElementById("cookie-accept")!.addEventListener("click", () => decide(ALL_ON));
	document.getElementById("cookie-reject")!.addEventListener("click", () => decide(ALL_OFF));
	document.getElementById("cookie-save")!.addEventListener("click", () => decide(readInputs()));

	window.addEventListener(OPEN_EVENT, () => {
		syncInputs(getStoredConsent() ?? ALL_OFF);
		banner.removeAttribute("hidden");
	});
</script>

<style>
	/* Tokens de tema y posicionamiento crítico del banner: viven en el atributo `style` inline
	   del elemento raíz (arriba), no aquí. Astro/Vite tiene un bug de compilación no determinista
	   que puede eliminar del CSS compilado la regla `.cookie-banner { ... }` que apunta al
	   elemento raíz del componente cuando coexiste con otras reglas en el mismo bloque `<style>`
	   (reproducido de forma aislada, sin causa raíz identificada con certeza — parece relacionado
	   con el chunking/minificado de CSS entre páginas). El resto de reglas (descendientes, nunca
	   la regla del elemento raíz) no se ha visto afectado en las pruebas. No vuelvas a poner aquí
	   una regla `.cookie-banner { ... }`: usa el atributo `style` del elemento raíz.

	   Para adaptar colores/tipografía a otro proyecto, redefine los custom properties en ese
	   mismo atributo `style` (o pásalos como prop del componente si se prefiere). */

	.cookie-banner__inner {
		max-width: 40rem;
		margin: 0 auto;
		background: var(--cookie-surface);
		color: var(--cookie-text);
		border-radius: var(--cookie-radius);
		padding: 1.25rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		box-shadow: 0 -2px 20px rgba(0, 0, 0, 0.3);
	}

	.cookie-banner__text {
		font-size: 0.875rem;
		line-height: 1.6;
		margin: 0;
		color: var(--cookie-text);
	}

	.cookie-banner__text a {
		color: var(--cookie-accent);
		text-decoration: underline;
	}

	.cookie-banner__categories {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.cookie-category {
		border-top: 1px solid rgba(255, 255, 255, 0.15);
		padding-top: 0.75rem;
	}

	.cookie-category__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-weight: 600;
		font-size: 0.9rem;
		cursor: pointer;
	}

	.cookie-category__always-on {
		font-weight: 400;
		opacity: 0.7;
		font-size: 0.75rem;
	}

	.cookie-category__desc {
		margin: 0.25rem 0 0;
		font-size: 0.8rem;
		color: var(--cookie-text);
		opacity: 0.8;
		line-height: 1.5;
	}

	.cookie-category__header input[type="checkbox"] {
		width: 1.15rem;
		height: 1.15rem;
		cursor: pointer;
	}

	.cookie-banner__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	.cookie-btn {
		cursor: pointer;
		border: none;
		border-radius: 0.25rem;
		font-size: 0.875rem;
		padding: 0.625rem 1.25rem;
		min-height: 44px;
		transition: opacity 0.15s;
		font-family: inherit;
	}

	.cookie-btn:hover {
		opacity: 0.85;
	}

	.cookie-btn--primary {
		background: var(--cookie-accent);
		color: var(--cookie-accent-text);
		font-weight: 600;
	}

	.cookie-btn--secondary {
		background: transparent;
		color: var(--cookie-text);
		opacity: 0.7;
		text-decoration: underline;
	}
</style>
