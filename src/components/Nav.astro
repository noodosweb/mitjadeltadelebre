---
import { Image } from 'astro:assets';
import logo from '../assets/images/mitja_delta_logo_blanco.png';
import logoPlp from '../assets/images/Logo - Grup PLP Dental.png';
import logoOliva from '../assets/images/grup_oliva_motor_logo_blanc.png';
import { pageMap, type Locale } from '../i18n/page-map';

interface Props {
  lang?: Locale;
  currentSlug?: string;
}

const { lang = 'ca', currentSlug = 'home' } = Astro.props;

const content = {
  ca: {
    menuItems: [
      { label: 'Informació', href: '#informacio' },
      { label: 'Serveis', href: '#serveis' },
      { label: 'Horaris', href: '#horaris' },
      { label: 'Recorregut', href: '#recorregut' },
      { label: 'Preu', href: '#preu' },
    ],
    cta: 'Inscripcions',
    openMenu: 'Obrir menú',
    homeAria: "Anar a l'inici",
    langLabel: 'CA',
    langOptions: [
      { code: 'ca' as Locale, label: 'Català' },
      { code: 'es' as Locale, label: 'Castellano' },
    ],
  },
  es: {
    menuItems: [
      { label: 'Información', href: '#informacio' },
      { label: 'Servicios', href: '#serveis' },
      { label: 'Horarios', href: '#horaris' },
      { label: 'Recorrido', href: '#recorregut' },
      { label: 'Precio', href: '#preu' },
    ],
    cta: 'Inscripciones',
    openMenu: 'Abrir menú',
    homeAria: 'Ir a inicio',
    langLabel: 'ES',
    langOptions: [
      { code: 'ca' as Locale, label: 'Català' },
      { code: 'es' as Locale, label: 'Castellano' },
    ],
  },
};

const t = content[lang];
const langHref = (code: Locale) => pageMap[currentSlug]?.[code] ?? `/${code}/`;
---

<header>
  <div class="nav-topbar">
    <div class="nav-topbar-inner">
      <div class="nav-socials">
        <a href="#" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"></path></svg>
        </a>
        <a href="#" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077"></path></svg>
        </a>
        <a href="#" aria-label="Strava" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"></path></svg>
        </a>
        <a href="#" aria-label="Wikiloc" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="M512 96c0 50.2-59.1 125.1-84.6 155c-3.8 4.4-9.4 6.1-14.5 5L320 256c-17.7 0-32 14.3-32 32s14.3 32 32 32l96 0c53 0 96 43 96 96s-43 96-96 96l-276.4 0c8.7-9.9 19.3-22.6 30-36.8c6.3-8.4 12.8-17.6 19-27.2L416 448c17.7 0 32-14.3 32-32s-14.3-32-32-32l-96 0c-53 0-96-43-96-96s43-96 96-96l39.8 0c-21-31.5-39.8-67.7-39.8-96c0-53 43-96 96-96s96 43 96 96zM117.1 489.1c-3.8 4.3-7.2 8.1-10.1 11.3l-1.8 2-.2-.2c-6 4.6-14.6 4-20-1.8C59.8 473 0 402.5 0 352c0-53 43-96 96-96s96 43 96 96c0 30-21.1 67-43.5 97.9c-10.7 14.7-21.7 28-30.8 38.5l-.6 .7zM128 352a32 32 0 1 0 -64 0 32 32 0 1 0 64 0zM416 128a32 32 0 1 0 0-64 32 32 0 1 0 0 64z"></path></svg>
        </a>
        <a href="#" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path></svg>
        </a>
      </div>

      <details class="nav-lang">
        <summary>{t.langLabel}</summary>
        <ul>
          {t.langOptions.map((opt) => (
            <li><a href={langHref(opt.code)} hreflang={opt.code}>{opt.label}</a></li>
          ))}
        </ul>
      </details>
    </div>
  </div>

  <nav>
    <div class="nav-logos">
      <a href={pageMap.home[lang]} aria-label={t.homeAria} class="nav-logo-link">
        <Image src={logo} alt="Mitja Marató Delta de l'Ebre" />
      </a>
      <span class="nav-logo-divider" aria-hidden="true"></span>
      <Image src={logoPlp} alt="Grup PLP Dental" class="nav-logo-plp" />
      <Image src={logoOliva} alt="Grup Oliva Motor" class="nav-logo-oliva" />
    </div>

    <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label={t.openMenu}>
      <span></span><span></span><span></span>
    </label>

    <div class="nav-menu-wrapper">
      <ul class="nav-menu">
        {t.menuItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>

      <a class="nav-cta" href="https://www.rockthesport.com/es/evento/mitja-delta-del-ebre" target="_blank" rel="noopener noreferrer">{t.cta}</a>
    </div>
  </nav>
</header>

<script>
  const navToggle = document.getElementById('nav-toggle');
  document.querySelectorAll('.nav-menu-wrapper a').forEach((link) => {
    link.addEventListener('click', () => {
      if (navToggle instanceof HTMLInputElement) navToggle.checked = false;
    });
  });
</script>

<style>
  header {
    background-color: var(--color-navy);
  }

  .nav-topbar {
    background-color: var(--color-navy-dark);
  }

  .nav-topbar-inner {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.25rem;
    padding: 0.4rem 1.5rem;
  }

  nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.5rem 1.5rem;
  }

  .nav-logos {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .nav-logo-link {
    display: flex;
    flex-shrink: 0;
  }

  .nav-logo-link img {
    height: 56px;
    width: auto;
    flex-shrink: 0;
  }

  .nav-logo-divider {
    width: 1px;
    height: 40px;
    background-color: rgba(255, 255, 255, 0.6);
    flex-shrink: 0;
  }

  .nav-logo-plp,
  .nav-logo-oliva {
    height: 28px;
    width: auto;
    flex-shrink: 0;
  }

  .nav-toggle-input {
    display: none;
  }

  .nav-toggle-label {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .nav-toggle-label span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: #fff;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-menu-wrapper {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .nav-menu a {
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    padding-bottom: 0.2rem;
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s ease;
  }

  .nav-menu a:hover {
    border-bottom-color: #fff;
  }

  .nav-socials {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .nav-socials a {
    display: flex;
    color: #fff;
    opacity: 0.85;
    transition: opacity 0.15s ease;
  }

  .nav-socials a:hover {
    opacity: 1;
  }

  .nav-socials svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .nav-lang {
    position: relative;
  }

  .nav-lang summary {
    list-style: none;
    cursor: pointer;
    color: #fff;
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.25rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .nav-lang summary::-webkit-details-marker {
    display: none;
  }

  .nav-lang summary::after {
    content: '▾';
    font-size: 0.65rem;
  }

  .nav-lang ul {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    background-color: #fff;
    border-radius: 8px;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
    min-width: 130px;
    z-index: 10;
  }

  .nav-lang li a {
    display: block;
    padding: 0.5rem 0.7rem;
    color: var(--color-navy);
    text-decoration: none;
    font-weight: 500;
    border-radius: 6px;
  }

  .nav-lang li a:hover {
    background-color: var(--color-gray-light);
  }

  .nav-cta {
    display: inline-block;
    background-color: #fff;
    color: var(--color-navy);
    font-weight: 700;
    padding: 0.6rem 1.4rem;
    border-radius: 999px;
    text-decoration: none;
    flex-shrink: 0;
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .nav-cta:hover {
    background-color: var(--color-delta-green);
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 900px) {
    .nav-topbar-inner {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem;
      padding: 0.5rem 1rem;
    }

    nav {
      padding: 0.5rem 1rem;
    }

    .nav-logo-link img {
      height: 44px;
    }

    .nav-logo-divider {
      height: 32px;
    }

    .nav-logo-plp,
    .nav-logo-oliva {
      height: 22px;
    }

    .nav-toggle-label {
      display: flex;
    }

    .nav-toggle-input:checked ~ .nav-toggle-label span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .nav-toggle-input:checked ~ .nav-toggle-label span:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle-input:checked ~ .nav-toggle-label span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .nav-menu-wrapper {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      background-color: var(--color-navy-dark);
      padding: 1.5rem;
      box-shadow: 0 12px 20px rgba(0, 0, 0, 0.25);
      z-index: 20;
    }

    .nav-toggle-input:checked ~ .nav-menu-wrapper {
      display: flex;
    }

    .nav-menu {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.1rem;
    }

    .nav-cta {
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .nav-socials {
      gap: 0.6rem;
    }
  }
</style>
